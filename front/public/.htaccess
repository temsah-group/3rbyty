# Hostinger (LiteSpeed/Apache): HTTPS, single-page app fallback, caching.
Options -MultiViews
RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Every path that is not a real file or folder goes to index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType application/manifest+json .webmanifest
  # The card reader's language data (/ocr/lang/*.traineddata.gz) is unzipped
  # by the page itself: sent as plain bytes, not as gzip-encoded text.
  RemoveEncoding .gz
  AddType application/octet-stream .gz
</IfModule>

<IfModule mod_headers.c>
  # Hashed build files never change
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Fonts, photos, logos and the card reader's files keep their names across
  # uploads; a month is long enough to matter and short enough to refresh.
  <FilesMatch "\.(woff2?|ttf|jpe?g|png|webp|svg|ico|gz|wasm)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.webmanifest$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  # index.html always fresh, so a new upload shows at once
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # The push service worker must update as soon as a new one is uploaded
  <FilesMatch "^push-sw\.js$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.traineddata\.gz$">
    Header unset Content-Encoding
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/manifest+json image/svg+xml
</IfModule>
