# Used by `npm run build` (the files you upload).
# Empty: the API is on the same domain (one site: the API serves this build).
VITE_API_URL=

# Shown on the help page and in the terms when the API sends no support details.
VITE_SUPPORT_EMAIL=support@3rbyty.com

# Google sign-in: the web OAuth client id (public). Empty hides the button.
VITE_GOOGLE_CLIENT_ID=186187478818-0hdqnb438l3dv16mb6q8a86rsp3ditvt.apps.googleusercontent.com

# The website's own address, no trailing slash: share previews (og:image) and robots.txt.
VITE_SITE_URL=https://3rbyty.com

# Browser push notifications (all public). Firebase console > Project settings:
# General > Your apps > Web app config, and Cloud Messaging > Web Push certificates
# (the key pair). Any of them empty hides the "browser notifications" switch.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=rbyty-72073
VITE_FIREBASE_SENDER_ID=186187478818
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
